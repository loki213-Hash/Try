# Multi-Index Indian Options Signal Bot Configuration
# Copy this file to .env and provide your actual API keys

# Operating Mode (Signal and paper-trading ONLY. Real live order placement is blocked)
ENVIRONMENT=production
DEBUG=false
PAPER_TRADING_MODE=true
ENABLE_LIVE_ORDERS=false

# Database Connection (Default is SQLite, change to PostgreSQL for production deployment)
DATABASE_URL=sqlite+aiosqlite:///./trading.db
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/trading_db

# Broker Selection ('dhan', 'upstox', or 'simulated')
PRIMARY_BROKER=dhan
FALLBACK_BROKER=upstox

# DhanHQ API Credentials (V2 API: https://docs.dhanhq.co/)
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_jwt_access_token_here
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_WSS_URL=wss://api-feed.dhan.co

# Upstox API Credentials (V3 API: https://upstox.com/developer/api-documentation/)
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_WSS_URL=wss://api.upstox.com/v2/feed/market-data-feed

# Marketaux News API (https://marketaux.com/ - 100 requests/day free tier)
MARKETAUX_API_TOKEN=your_marketaux_api_token_here

# Telegram Bot API (https://core.telegram.org/bots/api)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id

# Paper Trading & Risk Controls
ACCOUNT_CAPITAL=500000.0
RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS_PCT=0.010
MAX_DAILY_STOP_LOSSES=2
MAX_CONCURRENT_TRADES=2
MAX_CORRELATED_EXPOSURE=1
MAX_QUOTE_STALENESS_SECONDS=5.0
